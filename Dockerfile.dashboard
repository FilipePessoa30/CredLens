# Optional local container for the CredLens Decision Intelligence Dashboard
# (Phase 7) - DEMO MODE ONLY. Not a production deployment, not built/pushed
# anywhere by this project; see dashboard/README.md for the direct
# `uv run credlens dashboard run --demo` alternative, which needs no Docker
# at all.
#
# Build (from the repository root):
#   docker build -f Dockerfile.dashboard -t credlens-dashboard-demo .
# Run:
#   docker run --rm -p 8501:8501 credlens-dashboard-demo
# Then open http://localhost:8501 - dashboard/demo_data/ (Fase 13:
# deliberately EXCLUDED from the build context by .dockerignore - it is
# gitignored source-of-truth-wise, so whatever happened to exist on the
# BUILD MACHINE's disk would otherwise be baked in non-deterministically)
# is generated in-process, deterministically, from a fixed seed the first
# time a page needs it (credlens.dashboard.bootstrap, the same factory
# `credlens demo prepare` calls) - no external network access needed
# either way. This DOES include a real local dbt-duckdb build against an
# ephemeral, container-local DuckDB file (see below) - "no warehouse
# mount" means no EXTERNAL/live warehouse connection, not that the build
# step is skipped.
#
# The CLI also works directly, no `uv run` prefix needed (the venv's own
# bin/ is first on PATH):
#   docker run --rm <image> credlens --help
#   docker run --rm <image> credlens doctor
#
# To persist the generated demo bundle across container restarts (optional
# - a fresh container regenerates it deterministically in ~20s either way),
# mount a volume at a PARENT of CREDLENS_DASHBOARD_DEMO_DIR, never at that
# exact path itself (a container volume mount point's inode can't be
# removed/renamed from inside the container - credlens.demo.factory's
# atomic-replace step needs to be able to at least create/replace the leaf
# directory). Fresh named volumes are root-owned by default; this image's
# non-root `credlens` user (uid 1000) needs it chowned once before first
# use - standard Docker practice for any non-root image + named volume:
#   docker volume create credlens-demo-vol
#   docker run --rm -v credlens-demo-vol:/data --user root \
#     credlens-dashboard-demo chown -R 1000:1000 /data
#   docker run --rm -p 8501:8501 -v credlens-demo-vol:/data \
#     -e CREDLENS_DASHBOARD_DEMO_DIR=/data/demo_data credlens-dashboard-demo

FROM python:3.11-slim AS base

# Fase 14 security gate: picks up whatever Debian security patches are
# already published for this image's system packages at build time
# (standard, recommended Docker practice - the base image's own package
# snapshot is not automatically current just because the image tag
# itself is recent). Confirmed necessary by a real Trivy scan finding
# multiple HIGH/CRITICAL Debian CVEs with an available fix that this
# step resolves; CVEs still reported with no upstream Debian fix at all
# (e.g. several perl-base entries) are unaffected by this and are
# handled as documented, non-blocking exceptions - see
# credlens.release.security's own module docstring.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Runtime deps only: build-essential/curl are not needed since uv and
# dbt-duckdb both install prebuilt wheels. uv itself (a compiled Rust
# binary) vendors its own copies of several crates - 0.11.7 bundled
# quinn-proto/rustls-webpki versions with real, fixed HIGH-severity
# advisories (GHSA-4w2j-m93h-cj5j, GHSA-82j2-j2ch-gfr8) - confirmed by a
# real Trivy scan; upgraded to the newest available release, which
# bundles patched versions. pip/setuptools (already present in the base
# image) are also upgraded here: setuptools vendors its own copies of
# wheel/jaraco.context internally, and the base image's preinstalled
# pip/setuptools/vendored-wheel were old enough to carry their own real,
# fixed CVEs (pip CVE-2025-8869 &al., setuptools CVE-2026-59890, wheel
# CVE-2026-24049, jaraco.context CVE-2026-23949).
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir uv==0.12.3

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
COPY dashboard/ ./dashboard/
COPY analysis/ ./analysis/
# credlens.generation.suite.generate_suite() (invoked by the demo-bundle
# auto-generation below) loads baseline's AND every CRN_SCENARIOS
# scenario's config/synthetic/<scenario>.generation.yaml - see the
# matching .dockerignore comment for how this was found (real ConfigError
# tracebacks on 7 of 10 dashboard pages) and why no other config/ file is
# needed for demo mode.
COPY config/synthetic/*.generation.yaml ./config/synthetic/
# The demo-bundle auto-generation's warehouse-build step runs `dbt build`
# against this project directory (a real, local, ephemeral DuckDB file
# under data/warehouse/ - never an external connection) - see the matching
# .dockerignore comment for how the missing directory was found (a real
# FileNotFoundError for warehouse/profiles.example.yml).
COPY warehouse/ ./warehouse/

# --extra analysis: credlens.analysis (KPI/insight/provenance logic the
# dashboard reuses). --extra dashboard: Streamlit/Plotly. --extra
# warehouse: dbt-core/dbt-duckdb - run_build() invokes a real local `dbt
# build` even in --demo mode (see the `COPY warehouse/` comment above), so
# this is needed too, not just the project files.
RUN uv sync --frozen --no-dev --extra warehouse --extra analysis --extra dashboard

# A non-root user, owning the whole /app tree. Needed for more than just
# dashboard/demo_data/ (excluded from the build context - see
# .dockerignore - so the demo-bundle auto-generation described above
# creates it at runtime): credlens.warehouse.build.BUILD_ROOT is also a
# relative "data/warehouse" path with no override parameter, resolving
# to /app/data/warehouse at runtime - confirmed by a real
# PermissionError when only demo_data/ was writable. Rather than
# whack-a-mole further undiscovered relative-path writes the same way,
# the whole tree is chowned once, consistent with /app being this
# container's own dedicated application directory, not shared system
# state - the non-root requirement is about not running the process as
# root, not about withholding write access from the unprivileged
# account that owns it.
RUN useradd --create-home --uid 1000 credlens \
    && chown -R credlens:credlens /app
USER credlens

ENV CREDLENS_DASHBOARD_DEMO=1 \
    CREDLENS_DASHBOARD_DEMO_DIR=/app/dashboard/demo_data \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)" || exit 1

CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--", "--demo"]
