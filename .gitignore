# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Package managers ---
# uv.lock IS versioned intentionally (reproducible installs). Do not ignore it.

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# --- Data (raw, interim, processed, external) ---
# The data/ directory must never carry real or downloaded datasets in version
# control. Only data/README.md and data/metadata/ (provenance records, no
# actual data) are versioned - see data/README.md for the full layout.
data/*
!data/README.md
!data/.gitkeep
!data/metadata/
data/metadata/*
!data/metadata/source_registry.yaml
!data/metadata/dataset_roles.yaml
!data/metadata/file_manifest.csv
!data/metadata/schemas/
data/metadata/schemas/*
!data/metadata/schemas/*.yaml
!data/metadata/licenses/
data/metadata/licenses/*
!data/metadata/licenses/*.md
!data/metadata/licenses/*.txt
*.csv
!data/metadata/file_manifest.csv
# Small, deliberately artificial contract-validation fixtures (never real
# or acquired data - see tests/fixtures/contracts/ and docs/data_contracts.md)
# must stay versioned; the blanket *.csv rule above exists to keep real/
# acquired data out of git, not to hide test fixtures from it. Discovered
# as a real, previously-silent gap during Phase 4A - see this phase's
# final report.
!tests/fixtures/**/*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls
*.zip
*.7z
*.gz
*.asc

# --- Local databases ---
*.db
*.duckdb
*.sqlite
*.sqlite3

# --- Power BI ---
*.pbix
*.pbit

# --- Docker (future phases) ---
*.env.docker

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ---
*.log
logs/

# --- Jupyter (Phase 7 notebook extra) ---
# Checkpoint files and an ad hoc executed-notebook copy are transient
# evidence of a `jupyter nbconvert --execute` run, never the source
# notebook itself (notebooks/*.ipynb IS versioned).
.ipynb_checkpoints/
*_executed.ipynb

# --- Modeling (Phase 8: behavioral early-warning model) ---
# Per-experiment working model artifacts (one .joblib per model kind per
# `credlens model train` run) are fully reproducible from the same
# --experiment-id/--seed (see reports/modeling/README.md) and grow with
# every experiment - never versioned. Only the curated, gate-passed
# candidate under reports/modeling/models/*.joblib (+ its .manifest.json)
# is versioned - small, deliberate, analogous to a champion reference
# artifact, not a scratch directory.
reports/modeling/experiments/*/models/

# Fase 11B Gate B: one quarantine manifest per local run that exercised
# input-contract quarantine handling (721 accidentally-tracked files
# found - see reports/release/tracked_cleanup_manifest.json) - fully
# reproducible, never curated release content.
reports/modeling/quarantine/

# --- Model validation (Phase 9: independent validation) ---
# The frozen evidence manifest carries a `frozen_at_utc` timestamp and is
# purely an internal integrity-check artifact (hashes already duplicated,
# in stable form, across decision.json/validation_report.md and the
# gitignored CSV tables) - never versioned, always regenerable via
# `credlens model validate-independent`.
reports/model_validation/evidence/

# --- Monitoring (Phase 9: production monitoring simulation) ---
# Fase 11B Gate B: one alert log and one run record per local
# monitoring-pipeline invocation (164 + 138 accidentally-tracked files
# found - see reports/release/tracked_cleanup_manifest.json) - fully
# reproducible via `credlens monitor run`/`evaluate`, never curated
# release content. The `RUN_*/` glob deliberately does NOT match
# reports/monitoring/runs/BATCHSET_REF_MODEL_behavioral_default_v1/ -
# that directory's batch_manifest.json is a genuine, load-bearing
# reference fixture the monitoring pipeline reads as INPUT, not
# ephemeral output, and stays versioned.
reports/monitoring/alerts/
reports/monitoring/runs/RUN_*/

# --- Warehouse (Phase 5: DuckDB + dbt) ---
# warehouse/ itself (SQL/YAML/macros/seeds/analyses/tests) IS versioned -
# only dbt's own generated/compiled artifacts and the rendered profile
# (which credlens.warehouse renders from profiles.example.yml at build
# time) are excluded. The actual .duckdb database files are already
# covered by the global *.duckdb rule above and are written under
# data/warehouse/ (already covered by data/* above), never under warehouse/.
warehouse/target/
warehouse/dbt_packages/
warehouse/profiles.yml
warehouse/.user.yml
